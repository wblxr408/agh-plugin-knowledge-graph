{
  "name": "@wblxr408/knowledge-graph-runtime",
  "version": "1.1.3",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Offline knowledge graph generator and AGH knowledge atlas",
  "exports": "./runtime.mjs",
  "engines": {
    "node": ">=24.10"
  },
  "files": [
    "runtime.mjs",
    "catalog.mjs",
    "preview.mjs",
    "client",
    "dist",
    "agnes.client.json",
    "setup.ps1",
    "generate.ps1",
    "build-client.mjs",
    "publish.mjs",
    "stage.py",
    "requirements.txt",
    "quartz.config.ts",
    "LICENSE",
    "README.md",
    "agh.market.json"
  ],
  "agnes": {
    "provides": [
      "ui",
      "service"
    ],
    "metadata": {
      "displayName": "Knowledge Atlas",
      "summary": "Explore notes, course materials and their shared concepts.",
      "description": "Browse a local Quartz graph, search its notes and inspect their source paths.",
      "locales": {
        "zh-CN": {
          "displayName": "知识图谱",
          "summary": "浏览笔记和课程资料之间的链接。",
          "description": "查看本地 Quartz 图谱、搜索资料，并核对资料原始路径。"
        }
      }
    },
    "plugins": [
      {
        "export": "runtime",
        "apiRange": "^5.0.0",
        "id": "ext:wblxr408/knowledge-graph-runtime/runtime",
        "runtime": "in-process",
        "inject": [
          "services"
        ],
        "services": [
          "knowledge.atlas.read"
        ],
        "capabilities": {
          "ui": true
        }
      }
    ],
    "clientDescriptors": [
      {
        "rowId": "ext:wblxr408/knowledge-graph-runtime/runtime",
        "path": "./agnes.client.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wblxr408/agh-plugin-knowledge-graph"
  }
}
